# Environment Variables
# Copy this to .env and fill in your values.
# Then: source .env  (or use direnv)

# Groq API key — required for all agents
# Get yours at: https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# Deepgram API key for TTS/STT audio generation
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# LLM backend: "ask" (default) | "groq" | "azure"
# ---------------------------------------------------------------------------
# LLM_BACKEND=azure

# Azure OpenAI — only used when LLM_BACKEND=azure
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
