# Custom LLM (primary) - Claude-backed proxy, OpenAI-incompatible custom shape.
# LLM_BASE_URL is the FULL endpoint including the path, e.g. http://192.168.159.1:8080/ask
LLM_BASE_URL=
LLM_API_KEY=
# Optional override of config.yaml's llm.model (e.g. "sonnet", "haiku")
LLM_MODEL=

# Azure OpenAI GPT-4o (fallback)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Deepgram TTS
DEEPGRAM_API_KEY=

# Langfuse (optional - degrades to no-op tracing if blank)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
