      "subtitle": "Making informed decisions for your architecture",
      "duration_frames": 270,
      "transition": "slideUp",
      "panels": [
        {
          "area": "main",
          "type": "ComparisonCard",
          "data": {
            "title": "Trade-Offs",
            "pros": [
              "Scalability — easily add more servers to handle increased load",
              "Flexibility — choose the best technology stack for each component",
              "Maintainability — separate concerns make maintenance easier"
            ],
            "cons": [
              "Added complexity — multiple components require more management",
              "Communication overhead — client-server interactions introduce latency",
              "Security concerns — multiple components increase the attack surface"
            ]
          }
        }
      ]
