      "panels": [
        {
          "area": "left",
          "type": "BulletList",
          "data": {
            "title": "The Problem",
            "items": [
              "Monolithic systems are hard to scale — adding more users or data leads to exponential complexity",
              "Tight coupling leads to cascading failures — a single issue can bring down the entire system",
              "Maintenance and updates are challenging — changing one part affects the entire system"
            ]
          }
        },
        {
          "area": "right",
          "type": "StatCallout",
          "data": {
            "title": "The Cost of Complexity",
            "value": 75,
            "suffix": "%",
            "description": "of system failures due to complexity — a staggering 75% of system failures can be attributed to complexity issues"
          }
        }
      ]
    },
