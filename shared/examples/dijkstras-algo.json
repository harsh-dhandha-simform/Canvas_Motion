          "data": {
            "title": "Why brute force fails",
            "body": "Enumerating paths is exponential, but shortest paths overlap heavily — the route to a far node contains the route to nearer nodes on the way. Dijkstra exploits this by solving nodes in order of distance, never revisiting a settled one.",
            "bullets": [
              "Path count grows factorially with graph size",
              "Optimal routes share prefixes — reuse them",
              "Settle nodes nearest-first, exactly once"
            ],
            "position": "right",
            "accentColor": "#38bdf8"
          }
        }
