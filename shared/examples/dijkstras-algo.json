          "size_ratio": 1,
          "delay_frames": 0,
          "data": {
            "title": "Dijkstra: Shortest Paths, Greedily Proven",
            "subtitle": "How a 1959 greedy idea still routes the internet",
            "accentColor": "#38bdf8",
            "align": "center"
          }
        }
      ]
    },
