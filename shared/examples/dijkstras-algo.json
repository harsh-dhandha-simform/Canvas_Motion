                    "type": "var",
                    "value": "d(u)"
                  },
                  {
                    "type": "op",
                    "value": "<"
                  },
                  {
                    "type": "var",
                    "value": "dist[u]"
                  }
                ]
              },
              {
                "label": "It leaves the settled set at edge x→y",
                "tokens": [
                  {
                    "type": "var",
                    "value": "dist[y]"
                  },
                  {
                    "type": "op",
                    "value": "≤"
                  },
                  {
                    "type": "var",
                    "value": "d(y)"
                  }
                ],
                "note": "y already relaxed while x was settled"
              },
              {
                "label": "Non-negative weights: rest of path only adds cost",
                "tokens": [
                  {
                    "type": "var",
                    "value": "d(y)"
                  },
                  {
                    "type": "op",
                    "value": "≤"
                  },
