# ---------------------------------------------------------------------------
backend/checkpoints/
backend/audio/
backend/renders/

# Per-request generated video scripts (curated demos live in shared/examples/).
shared/generated/

# ---------------------------------------------------------------------------
# Generated frontend sources (recreated by `npm run register-examples`).
